# Proposed fix for scripts/06_descriptive_stats.py
#
# Bug: is_proportional filter (line 108) is case-sensitive, but TSE 2016 raw
# data has DS_CARGO in UPPERCASE ('PREFEITO','VEREADOR'). 2022 federais also
# UPPERCASE ('DEPUTADO ESTADUAL' etc.) but those are out of paper scope.
#
# Consequence for 2016 Vereador: 267,755 party-legend votes (2-digit
# NR_VOTAVEL) are mis-classified as candidate votes, contaminating HHI, ENC,
# margin, and n_candidates for every Vereador 2016 polling station.
#
# Impact (means across stations, Vereador 2016):
#   HHI              0.0462 (buggy)  vs  0.0518 (correct)   -12%
#   ENC              37.00  (buggy)  vs  33.47  (correct)   +10%
#   margin           0.0545 (buggy)  vs  0.0583 (correct)    -7%
#   n_candidates     210.4  (buggy)  vs  193.0  (correct)   +17 spurious
#
# Fix: normalize DS_CARGO to Title Case right after filtering first round /
# metro RJ, BEFORE building is_proportional / is_legenda.
#
# ─── DIFF (scripts/06_descriptive_stats.py) ──────────────────────────────────

--- a/scripts/06_descriptive_stats.py
+++ b/scripts/06_descriptive_stats.py
@@ -91,6 +91,15 @@ def compute_competition_measures(df_votes, cand_status=None):
     if len(df) == 0:
         return pd.DataFrame()

+    # Normalize DS_CARGO to Title Case — raw TSE mixes cases across years
+    # (2016 is 'VEREADOR', 2022 is 'DEPUTADO ESTADUAL', others Title Case).
+    # Without this, is_proportional (below) returns False for 2016 Vereador,
+    # which causes party-legend votes (NR_VOTAVEL with 2 digits) to be
+    # classified as candidate votes, contaminating HHI/ENC/margin.
+    df['DS_CARGO'] = (df['DS_CARGO'].astype(str)
+                                     .str.strip()
+                                     .str.lower()
+                                     .str.title())
+
     df['QT_VOTOS'] = pd.to_numeric(df['QT_VOTOS'], errors='coerce').fillna(0).astype(int)

     # Separate candidate votes from special votes (null, blank) and party legend

